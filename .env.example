# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser
# (SPEC §10) — never put a provider API key in this file.
#
# Both values come from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The generation provider key is NOT set here. It lives only as an Edge Function
# secret, so it never ships to the client:
#   supabase secrets set GROQ_API_KEY=...
